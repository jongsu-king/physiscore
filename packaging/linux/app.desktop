[Desktop Entry]
Type=Application
Name=@NAME@
Comment=@SUMMARY@
Exec=@EXEC@
Icon=@ID@
Terminal=false
Categories=Science;Physics;
Keywords=solar cell;photovoltaic;J-V;EQE;XRD;XPS;Raman;FTIR;PL;TRPL;impedance;SCLC;C-V;stability;PLQY;QFLS;spectral mismatch;
Actions=guide;methods;

[Desktop Action guide]
Name=User guide (offline)
Exec=@EXEC@ --doc USER_GUIDE

[Desktop Action methods]
Name=Methods and algorithms (offline)
Exec=@EXEC@ --doc METHODS
